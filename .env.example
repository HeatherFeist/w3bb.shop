# Copy this file to .env and fill in your own values.
# These are safe to expose in the browser (the "anon" key is meant to be
# public — real security comes from Supabase Row Level Security policies,
# not from hiding this key).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Checkout redirects to Stripe's/Square's own hosted payment page, so the
# real secret keys (Stripe secret key, Square access token) live only in
# Supabase Edge Function secrets — never in this file, never anywhere the
# browser can see them. See README for how to set those.
